#usda 1.0
(
    defaultPrim = "Ground"
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "Ground"
{
    def Plane "Collision" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double width = 100
        double length = 100
        bool physics:collisionEnabled = true
        color3f[] primvars:displayColor = [(0.35, 0.35, 0.35)]
        rel material:binding:physics = </Ground/PhysicsMaterial>
    }
    def Material "PhysicsMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:staticFriction = 1
        float physics:dynamicFriction = 1
        float physics:restitution = 0
    }
}
