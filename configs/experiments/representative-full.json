{
  "schema_version": 1,
  "description": "Eight independent learners on one eight-GPU node; official task iteration defaults.",
  "checkpoint_interval": 250,
  "smoke_iterations": 5,
  "runs": [
    {
      "id": "mujoco-rsl-rl-walking",
      "backend": "mujoco",
      "framework": "rsl-rl",
      "task": "Mjlab-Velocity-Flat-MicroDuck",
      "experiment": "velocity",
      "num_envs": 4096,
      "iterations": 50000,
      "seed": 42
    },
    {
      "id": "mujoco-rsl-rl-stand_up",
      "backend": "mujoco",
      "framework": "rsl-rl",
      "task": "Mjlab-StandUp-Flat-MicroDuck",
      "experiment": "microduck_stand",
      "num_envs": 4096,
      "iterations": 15000,
      "seed": 42
    },
    {
      "id": "mujoco-sb3-walking",
      "backend": "mujoco",
      "framework": "sb3",
      "task": "Mjlab-Velocity-Flat-MicroDuck",
      "experiment": "velocity",
      "num_envs": 4096,
      "iterations": 50000,
      "seed": 42
    },
    {
