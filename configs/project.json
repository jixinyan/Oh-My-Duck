{
  "schema_version": 1,
  "name": "Oh My Duck",
  "scope": "Agentic Microduck: training, skills, perception, voice and traceable experience",
  "entry_point": "omd.py",
  "components": {
    "contracts": {
      "module": "oh_my_duck.core.contracts",
      "state": "implemented",
      "role": "Identity, sensor validity, task and episode schemas"
    },
    "robot_backends": {
      "module": "oh_my_duck.robotics.backends",
      "state": "interface_only",
      "role": "Online simulation/real robot execution"
    },
    "skills": {
      "module": "oh_my_duck.agentic.skills",
      "state": "interface_only",
      "role": "Skill declarations and execution lifecycle"
    },
    "tools": {
      "module": "oh_my_duck.agentic.tools",
      "state": "registry_implemented",
      "role": "Expose only registered tool handlers"
    },
    "harness": {
      "module": "oh_my_duck.agentic.harness",
      "state": "interface_only",
      "role": "External harness bridge; deterministic mock is next"
    },
    "voice": {
      "module": "oh_my_duck.voice",
      "state": "interface_only",
      "role": "ASR, voice profile, TTS and audio interfaces"
    },
    "recording": {
      "module": "oh_my_duck.experience",
      "state": "jsonl_implemented",
      "role": "Persist episode evidence without memory/planning"
    },
    "training": {
      "module": "oh_my_duck.rl.training",
      "state": "owned_task_source_migrated_gpu_revalidation_pending",
      "role": "Independent simulation-backend and RL-framework selection, offline training and evaluation"
    },
    "perception": {
      "module": "oh_my_duck.perception",
      "state": "interface_only",
      "role": "Active observation and evidence-backed target records"
    },
    "policies": {
      "module": "oh_my_duck.robotics.policies",
      "state": "interface_only",
      "role": "Distinct joint, velocity and action-sequence policy adapters"
    },
    "application": {
      "module": "oh_my_duck.agentic.application",
      "state": "composition_interface",
      "role": "Explicit injection of services without starting models or an agent loop"
    }
  },
  "training_backends": {
    "mujoco": {
      "state": "owned_source_cpu_verified_gpu_revalidation_pending",
      "physics": "MuJoCo-Warp",
      "environment": ".envs/mujoco",
      "environment_framework": "mjlab"
    },
    "isaac-newton": {
      "state": "pd_physics_video_and_rl_smoke_passed",
      "physics": "Newton",
      "solver": "MuJoCo-Warp",
      "environment": ".envs/isaac-newton",
      "asset_environment": ".envs/isaac-assets",
      "locomotion": "official_BAM_replay_exercised_collision_and_task_migration_in_progress",
      "environment_state": "installed_cpu_configuration_checked",
      "asset_environment_state": "conversion_worker_verified",
      "environment_framework": "Isaac Lab"
    }
  },
  "execution": {
    "hardware_available": false,
    "harness": "external_with_planned_mock",
    "server_jobs": "Alaya HTrain",
    "headless": true,
    "video": "offscreen"
  },
  "rl_framework_registry": "oh_my_duck.rl.training.frameworks:default_framework_registry"
}
